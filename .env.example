# Copy this file to .env and fill in real values. Never commit .env.

FLASK_APP=run.py
FLASK_CONFIG=development
FLASK_DEBUG=1

# Use long random strings in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-to-a-random-string
JWT_SECRET_KEY=change-this-to-another-random-string

# SQLite is the default for local dev. Swap for Postgres when deploying:
# DATABASE_URL=postgresql://user:password@host:5432/cloudops
DATABASE_URL=sqlite:///cloudops_dev.db
